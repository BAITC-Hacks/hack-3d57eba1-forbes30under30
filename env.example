# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает.

# Ключ OpenAI API (обязательно). Получить: platform.openai.com -> API keys
OPENAI_API_KEY=

# Модель OpenAI по умолчанию
OPENAI_MODEL=

# Резервный провайдер (необязательно). NVIDIA Build, OpenAI-совместимый endpoint
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Порт приложения
PORT=3000
